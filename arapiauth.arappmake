ALRIGROUP@APPMAKE
{
  "name": "arapiauth",
  "bin": "arapiauth.arapp",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "arapiauth",
  "platforms": {
    "windows": {"entry": "arapiauth"},
    "linux": {"entry": "arapiauth"},
    "linux-x64": {"entry": "arapiauth"},
    "linux-arm64": {"entry": "arapiauth"}
  },
  "build": {
    "staging": "$ARCORE/.staging/$APP_NAME",
    "steps": [
      {
        "name": "cc",
        "cmd": "gcc -O2 -I. -I../../ALRIOS/core -I../../ALRIOS/arkernel/include -I../../ALRIOS/arkernel/os/include -o $STAGING/arapiauth arapiauth_entry.c arapiauth_config.c arapiauth_client.c arapiauth_http.c -L$ARCORE/lib -larkernel -lssl -lcrypto -lpthread"
      }
    ]
  },
  "files": [
    "arapiauth",
    "arapiauth.cfg"
  ]
}
